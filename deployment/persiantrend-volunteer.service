[Unit]
Description=PersianTrend small-group volunteer TCP relay
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=persiantrend
Group=persiantrend
WorkingDirectory=/opt/persiantrend
# Prepare operator-config.json and identity.json under this StateDirectory first.
ExecStart=/opt/persiantrend/bin/persiantrend-volunteer --data-dir /var/lib/persiantrend
StateDirectory=persiantrend
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/persiantrend
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
